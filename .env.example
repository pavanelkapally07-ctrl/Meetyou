PORT=3000
NODE_ENV=development
# Production: set a strong random SESSION_SECRET and configure HTTPS/reverse proxy.
SESSION_SECRET=replace-with-a-long-random-secret
# Payments are intentionally not enabled in this demo. Add Razorpay keys only on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
